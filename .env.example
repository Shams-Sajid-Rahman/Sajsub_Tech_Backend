# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection used by Prisma
# URL-encode special characters in the password (e.g. @ becomes %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sajsub_tech?schema=public"
