# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection used by Prisma
# URL-encode special characters in the password (e.g. @ becomes %40)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sajsub_tech?schema=public"

# Initial admin account, used by `npm run admin:create` and the development seed.
# Use a strong password of at least 12 characters. Change it after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Admin

# Reverse proxies in front of the API, used for correct client IPs in rate limiting. 0 in local development.
TRUST_PROXY=0

# Authentication secrets: at least 32 random characters each, different per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
# lax is right when the site and API share a domain. Use none (HTTPS only) if they don't.
COOKIE_SAMESITE=lax

# Outgoing email for password resets. Without SMTP_HOST, development prints reset links to
# the backend terminal, and production cannot send them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Image uploads. Find these in your Cloudinary dashboard. Uploads return 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Online payment through SSLCommerz. Register a free sandbox store at developer.sslcommerz.com.
# Online payment stays switched off until both are set.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Keep true for testing. false takes real money.
SSLCOMMERZ_SANDBOX=true
# The public address of this API, used for payment callbacks. Defaults to http://localhost:PORT.
API_PUBLIC_URL=

# AI shopping assistant, on the Gemini free tier. Create a key at aistudio.google.com, and leave billing off.
# The assistant stays off until this is set. See docs/AI_ASSISTANT.md.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
AI_MODEL=
